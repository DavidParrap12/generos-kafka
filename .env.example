# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (POSTGRESQL)
# ==========================================
DB_HOST=localhost
DB_PORT=5433
DB_NAME=generosdb
DB_USER=postgres
DB_PASSWORD=tu_contrasena_aqui

# ==========================================
# CONFIGURACIÓN DE KAFKA
# ==========================================
KAFKA_BOOTSTRAP=localhost:29092
KAFKA_TOPIC=generos
KAFKA_GROUP_ID=generos-consumer-group

# Opciones sugeridas en el productor (separadas por coma).
# El usuario puede elegir una o escribir cualquier otro género.
GENEROS_SUGERIDOS=Femenino,Masculino,No binario,Otro,Prefiero no decirlo

# ==========================================
# CONFIGURACIÓN DE FIREBASE FIRESTORE
# ==========================================
GOOGLE_APPLICATION_CREDENTIALS=firebase-key.json
FIRESTORE_COLLECTION=generos
